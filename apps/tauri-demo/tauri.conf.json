{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rust-ui",
  "version": "0.0.0",
  "identifier": "com.rustui.demo",
  "build": {
    "frontendDist": "../web-demo/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd ../web-demo && trunk serve --port 1420",
    "beforeBuildCommand": "cd ../web-demo && trunk build --release"
  },
  "app": {
    "windows": [
      {
        "title": "rust-ui (tauri-demo)",
        "width": 960,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

